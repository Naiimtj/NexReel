# =============================================================================
# FastAPI (backend) — variables propias del servicio.
#   • Host dev:  copia a `fastapi/.env` (lo cargan pydantic-settings y `just dev`).
#   • Docker:    se inyecta vía `env_file` en el docker-compose.yml de la raíz.
# Las genéricas (TZ, POSTGRES_*) están en el `.env` de la raíz.
# =============================================================================

# Host de PostgreSQL para desarrollo en host (en Docker Compose es `postgres`).
POSTGRES_HOST=127.0.0.1

# Secreto de sesión — genera con:  openssl rand -hex 32
SESSION_SECRET=change-me-session-secret

# Contraseña del header admin para los endpoints /db/*
BACKUP_ADMIN_PASSWORD=change-me-backup-admin

# CORS: orígenes permitidos (coma-separado).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5172,http://localhost:5173,http://localhost:5172,http://localhost:3000,http://127.0.0.1:3000,http://nexreel.duckdns.org

# Directorio de backups (host dev).
BACKUP_DATA_DIR=../database/backup_data

# Cloudinary (subida de imágenes).
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Plex.
PLEX_URL=http://
PLEX_API_KEY=

# Usuario admin inicial (bootstrap opcional).
ADMIN_EMAIL=
ADMIN_USER=
ADMIN_PASSWORD=
