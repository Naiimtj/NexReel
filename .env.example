# =============================================================================
# Variables genéricas / compartidas de NexReel.
# Las lee Docker Compose (sustitución ${...}) y el justfile (dotenv-load).
# Las específicas de cada servicio viven aparte:
#   • Backend  → fastapi/.env   (ref: fastapi/.env.example)
#   • Frontend → web/.env        (ref: web/.env.template)
# =============================================================================

TZ=Europe/Madrid

# ── PostgreSQL (compartida por postgres, fastapi y backup) ──────────────────
POSTGRES_DB=nexreel
POSTGRES_USER=nexreel
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
# Usa `naiteca_nexreel_postgres_data` al migrar el volumen del monolito antiguo.
POSTGRES_VOLUME_NAME=nexreel_postgres_data

# ── Frontend (contenedor web) ───────────────────────────────────────────────
# Puerto público del contenedor `web` en el host (servidor: 80).
NEXREEL_WEB_PORT=8080
